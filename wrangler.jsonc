{
  "name": "my-greenhouse-cabinet",
  "main": "worker.js",
  "compatibility_date": "2026-11-16",
  "workers_dev": true,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "greenhouse-cabinet",
      "database_id": "8ae2aa6a-5532-4abd-a33e-0a37fd1ec032"
    }
  ]
}
